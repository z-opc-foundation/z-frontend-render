{
  "name": "@yuku123/render",
  "version": "1.0.1",
  "type": "module",
  "description": "平台共享前端渲染引擎: schema → antd/echarts 渲染 + 12 栏栅格布局编辑 + 字段类型注册表 (z-report / z-lc 共用)",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "yuku123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-opc-foundation/z-render.git"
  },
  "bugs": "https://github.com/z-opc-foundation/z-render/issues",
  "homepage": "https://github.com/z-opc-foundation/z-render#readme",
  "keywords": [
    "renderer",
    "schema",
    "antd",
    "echarts",
    "low-code",
    "dashboard",
    "field-registry",
    "yuku123"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fields": {
      "types": "./dist/fields/index.d.ts",
      "default": "./dist/fields.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run clean && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5.0.0",
    "@dnd-kit/core": ">=6.1.0",
    "@dnd-kit/sortable": ">=8.0.0",
    "@dnd-kit/utilities": ">=3.2.0",
    "antd": ">=5.29.0 || ^6.0.0",
    "dayjs": ">=1.11.0",
    "echarts": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@ant-design/icons": {
      "optional": true
    },
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "antd": "^6.3.3",
    "dayjs": "^1.11.23",
    "echarts": "^5.5.1",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
